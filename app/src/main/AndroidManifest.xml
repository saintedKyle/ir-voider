<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Android 11+ package visibility: let the shortcut row address Chrome.
         Prime, Copilot and Web always open there; Netflix and YouTube fall back
         to the browser when the profile has no IR key. -->
    <queries>
        <package android:name="com.android.chrome" />
    </queries>

    <!-- Only used by the optional update check. Every remote feature works fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The launcher sees a calculator. LockActivity is the only entry point; MainActivity is
         not exported, so nothing outside this app can start the vault screen directly. -->
    <application
        android:name=".VaultApp"
        android:label="Calculator"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:label="Calculator"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LearnActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ConfigsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
